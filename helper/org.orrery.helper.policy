<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.orrery.helper">
    <description>Change boot and login settings</description>
    <description xml:lang="it">Modifica le impostazioni di avvio e login</description>
    <message>Authentication is required to change boot and login settings</message>
    <message xml:lang="it">Serve l'autenticazione per modificare le impostazioni di avvio e login</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/orrery/orrery-helper</annotate>
  </action>
</policyconfig>
